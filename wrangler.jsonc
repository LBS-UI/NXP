{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snapstudio-api",
  "main": "./worker.js",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "snapstudio-images"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://YOUR_USERNAME.github.io,http://localhost:5500,http://127.0.0.1:5500",
    "MAX_UPLOAD_BYTES": "8388608",
    "IMAGE_TTL_HOURS": "24"
  },
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
